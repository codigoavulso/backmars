# Public/runtime identity
WEBMARS_USERS_ENV=production
WEBMARS_PUBLIC_URL=https://mips.example.edu
WEBMARS_USERS_ALLOWED_ORIGINS=https://mips.example.edu
WEBMARS_USERS_TRUSTED_PROXIES=1

# Generate these independently. Never commit real values.
SECRET_KEY=<generate-a-random-session-secret>
BACKMARS_ACCOUNT_CODE_PEPPER=<generate-a-different-random-code-secret>

# Keep mutable data outside the code checkout.
BACKMARS_DATABASE=/var/lib/backmars/app.db
WEBMARS_USERS_DATABASE_BUSY_TIMEOUT_MS=5000
WEBMARS_USERS_MAX_CONTENT_LENGTH=4194304

# HTTPS session cookies (use SameSite=None only for genuine cross-site HTTPS).
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax

# Gmail example. Store the Google App Password only in the installed root-only file.
BACKMARS_MAIL_ENABLED=1
BACKMARS_MAIL_FROM=webmars.noreply@gmail.com
BACKMARS_MAIL_FROM_NAME=webMARS
BACKMARS_SMTP_HOST=smtp.gmail.com
BACKMARS_SMTP_PORT=587
BACKMARS_SMTP_SECURITY=starttls
BACKMARS_SMTP_USERNAME=webmars.noreply@gmail.com
BACKMARS_SMTP_PASSWORD=<google-app-password>
BACKMARS_SMTP_TIMEOUT_SECONDS=15
BACKMARS_MAIL_SEND_ASYNC=1

# Account policy and abuse limits
BACKMARS_REQUIRE_VERIFIED_EMAIL_FOR_PUBLISH=1
BACKMARS_PASSWORD_MIN_LENGTH=8
BACKMARS_PASSWORD_MAX_LENGTH=1024
BACKMARS_USERNAME_MAX_LENGTH=64
BACKMARS_REGISTER_MAX_ATTEMPTS=20
BACKMARS_REGISTER_WINDOW_SECONDS=3600
WEBMARS_USERS_LOGIN_MAX_ATTEMPTS=20
WEBMARS_USERS_LOGIN_WINDOW_SECONDS=900
BACKMARS_CODE_TTL_SECONDS=600
BACKMARS_CODE_MAX_ATTEMPTS=5
BACKMARS_CODE_USER_LIMIT_PER_HOUR=5
BACKMARS_CODE_ADDRESS_LIMIT_PER_HOUR=20

# Public Library limits
BACKMARS_PUBLICATION_LIST_LIMIT=50
BACKMARS_PUBLICATION_MAX_TAGS=8
BACKMARS_PUBLICATION_MAX_TITLE_LENGTH=120
BACKMARS_PUBLICATION_MAX_DESCRIPTION_LENGTH=2000
BACKMARS_PUBLICATION_MAX_INSTRUCTIONS_LENGTH=12000
BACKMARS_PUBLICATION_MAX_FILES=128
BACKMARS_PUBLICATION_MAX_FILE_BYTES=524288
BACKMARS_PUBLICATION_MAX_TOTAL_BYTES=1048576
BACKMARS_PUBLICATION_MAX_PATH_DEPTH=8
